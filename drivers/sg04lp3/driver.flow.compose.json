{
  "triggers": [
    {
      "id": "data_updated",
      "title": { "en": "Measured data updated" },
      "hint": { "en": "Fires after every successful read of the inverter" },
      "tokens": [
        { "name": "solar_power", "type": "number", "title": { "en": "Solar power (W)" }, "example": 3200 },
        { "name": "battery_power", "type": "number", "title": { "en": "Battery power (W, − = charging)" }, "example": -1500 },
        { "name": "grid_power", "type": "number", "title": { "en": "Grid power (W, − = exporting)" }, "example": -800 },
        { "name": "load_power", "type": "number", "title": { "en": "Load power (W)" }, "example": 900 },
        { "name": "battery_soc", "type": "number", "title": { "en": "Battery (%)" }, "example": 80 },
        { "name": "surplus", "type": "number", "title": { "en": "Surplus (W)" }, "example": 2300 }
      ]
    }
  ],
  "conditions": [
    {
      "id": "value_held",
      "title": { "en": "Value has !{{been|not been}} above/below a limit for a while" },
      "titleFormatted": {
        "en": "[[quantity]] has !{{been|not been}} [[comparison]] [[threshold]] for the last [[seconds]] seconds"
      },
      "hint": {
        "en": "True only if every reading in the window is beyond the limit, readings cover the whole window (it is false right after 'Restart history' until enough new readings arrive), and the latest reading is fresh."
      },
      "args": [
        {
          "name": "quantity",
          "type": "dropdown",
          "title": { "en": "Value" },
          "values": [
            { "id": "surplus", "title": { "en": "Surplus" } },
            { "id": "solar", "title": { "en": "Solar power" } },
            { "id": "battery", "title": { "en": "Battery %" } }
          ]
        },
        {
          "name": "comparison",
          "type": "dropdown",
          "title": { "en": "Comparison" },
          "values": [
            { "id": "above", "title": { "en": "above" } },
            { "id": "below", "title": { "en": "below" } }
          ]
        },
        {
          "name": "threshold",
          "type": "number",
          "title": { "en": "Limit" },
          "placeholder": { "en": "3000" }
        },
        {
          "name": "seconds",
          "type": "number",
          "title": { "en": "Seconds" },
          "min": 1,
          "max": 900,
          "step": 1,
          "placeholder": { "en": "60" }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "set_surplus_offset",
      "title": { "en": "Set surplus offset" },
      "titleFormatted": { "en": "Set surplus offset to [[offset]] W" },
      "hint": { "en": "Surplus = −battery power − grid power + offset. E.g. 1700 while the battery is nearly full, 0 otherwise." },
      "args": [
        {
          "name": "offset",
          "type": "number",
          "title": { "en": "Offset (W)" },
          "min": -20000,
          "max": 20000,
          "step": 1,
          "placeholder": { "en": "1700" }
        }
      ]
    },
    {
      "id": "restart_history",
      "title": { "en": "Restart history" },
      "hint": { "en": "Forget earlier readings, e.g. right after a heater was switched, so that conditions only look at readings taken since." }
    }
  ]
}
